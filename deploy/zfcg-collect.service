[Unit]
Description=zfcg collect today's Shanghai announcements
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=zfcg-notify@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/zfcg
EnvironmentFile=-/opt/zfcg/.env
Environment=PATH=/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env node /opt/zfcg/src/index.js --no-save
TimeoutStartSec=7200
Nice=10
