[Unit]
Description=zfcg tag today's new awards
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/zfcg
EnvironmentFile=-/opt/zfcg/.env
Environment=PATH=/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env node /opt/zfcg/src/tag-awards.js --today
TimeoutStartSec=3600
Nice=10
