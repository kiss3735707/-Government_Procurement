[Unit]
Description=ZFCG backfill award industry labels
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/zfcg
EnvironmentFile=-/opt/zfcg/.env
ExecStart=/usr/bin/env node /opt/zfcg/src/classify-industries.js
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
